# 운영 배포에 필요한 환경변수 목록. 로컬 개발은 이 파일이 필요 없다 —
# docker-compose.yml + backend/application-local.yml + frontend/.env.local이 로컬 기본값을 이미 제공한다.
# 여기 있는 값들은 backend/application-prod.yml(SPRING_PROFILES_ACTIVE=prod)이 요구하는
# 필수값이며, 비어 있으면 백엔드가 기동 자체를 실패한다(고의적인 fail-fast, ADR-0044 참고).

# --- 백엔드: 데이터베이스 ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/quno
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_MONGODB_HOST=
SPRING_MONGODB_PORT=27017
SPRING_MONGODB_DATABASE=quno
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=6379

# --- 백엔드: 메일(실제 이메일 도메인 인증에 사용, ADR-0035) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# --- 백엔드: 시크릿 ---
# 최소 32바이트 이상의 무작위 문자열을 권장(HMAC 서명용). 예: openssl rand -base64 48
QUNO_JWT_SECRET=

# 토스페이먼츠 가맹점 계약 후 발급받는 실 키(ADR-0037). 계약 전까지는 공개 테스트 키를 써야 하며,
# 그 경우 이 프로필(prod) 자체를 쓰지 않는 것을 권장한다.
QUNO_TOSS_CLIENT_KEY=
QUNO_TOSS_SECRET_KEY=

# --- 백엔드: CORS ---
# 콤마로 구분한 실 프론트엔드 도메인 목록. 예: https://quno.example.com,https://www.quno.example.com
QUNO_CORS_ALLOWED_ORIGINS=

# --- 백엔드: 에러 트래킹(선택, ADR-0045) ---
# 계정 개설·DSN 발급은 사람이 할 일(A 항목) — 비워두면 SDK가 스스로 비활성화되어 기동에는 지장 없다.
SENTRY_DSN=

# --- 프론트엔드: 빌드 타임에 번들에 굽히는 값(frontend/Dockerfile 빌드 인자로 전달) ---
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://example.com
# 선택(ADR-0045) — 비워두면 프론트엔드 에러 리포팅이 console.error만 하고 Sentry로는 보내지 않는다.
NEXT_PUBLIC_SENTRY_DSN=
