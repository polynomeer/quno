root = true

# ktlint는 .editorconfig가 아예 없으면 관대한 intellij_idea 코드 스타일을 기본으로 쓰고,
# .editorconfig가 하나라도 있으면(이 파일처럼) ktlint_code_style을 명시하지 않는 한 더 엄격한
# ktlint_official로 자동 전환한다 — 그 상태로 기존 코드베이스에 처음 ktlintFormat을 돌렸다가
# 408개 파일, 9천 줄 넘게 재포맷될 뻔한 것을 확인하고(스타일만 바뀌지만 diff가 너무 커서 되돌림)
# 명시적으로 intellij_idea를 유지하기로 했다 — 기존 스타일이 이미 관대한 기본값에 맞아 위반이
# 0건이었다.
[*.kt]
ktlint_code_style = intellij_idea
indent_size = 4
indent_style = space
# 이 프로젝트는 관련 DTO를 종류별로 묶어 파일 하나에 모아둔다(예: application/*/dto/Commands.kt,
# Results.kt가 여러 커맨드/결과 데이터 클래스를 담음) — 지금 그 안에 클래스가 하나뿐인 파일도
# 나중에 늘어날 걸 전제로 이 이름을 쓰므로, "파일명은 안에 있는 단일 클래스 이름과 같아야 한다"는
# 규칙과 충돌한다. 의도적인 컨벤션이라 규칙을 끈다.
ktlint_standard_filename = disabled

# build.gradle.kts 등 Gradle Kotlin DSL 스크립트는 기존에 탭을 써왔으므로 그것까지 스페이스로
# 강제하지 않는다.
[*.kts]
ktlint_code_style = intellij_idea
indent_size = 4
indent_style = tab
